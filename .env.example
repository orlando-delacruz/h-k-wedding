# Copy to .env and fill in real values. Never commit this file.

# ---- Admin login (server-side only) -----------------------------------------
# Simple by design: one email and one password, read from the environment.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-password-at-least-8-characters

# ---- Sessions ---------------------------------------------------------------
# Signs the admin and guest cookies. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Server ----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Set true when the site is served over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# Allowed site origin for CORS and origin checks, e.g. https://your-domain.vercel.app
SITE_ORIGIN=http://localhost:5173

# ---- Storage ---------------------------------------------------------------
# Leave STORAGE_DRIVER unset to auto-detect: Vercel Blob when blob credentials
# are present, otherwise local disk.
# STORAGE_DRIVER=blob            # force Vercel Blob
# STORAGE_DRIVER=file            # force local disk
#
# On Vercel, connect a Blob store to the project. Either OIDC (BLOB_STORE_ID +
# VERCEL_OIDC_TOKEN) or a static BLOB_READ_WRITE_TOKEN works. Local development
# needs the workbook file path instead.
# BLOB_READ_WRITE_TOKEN=
# WORKBOOK_BLOB_PATH=rsvp/rsvps.xlsx
DATA_DIR=
WORKBOOK_PATH=
AUDIO_DIR=

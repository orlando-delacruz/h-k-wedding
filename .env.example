# Copy to .env (gitignored) and fill in.
# Anything prefixed VITE_ is public: Vite inlines it into the browser bundle, so
# never put a real secret in this file.

# Access code that opens the invitation gate (docs/05). Also set it in Vercel.
# Empty falls back to the placeholder in src/config/site.js.
VITE_ACCESS_CODE=
